<script>
(function () {
  "use strict";

  const USERS_KEY = "barangay_users";
  const SESSION_KEY = "barangay_session";
  const MAX_FAILED = 5;
  const LOCK_MS = 5 * 60 * 1000;
  const SESSION_MS = 8 * 60 * 60 * 1000;
  const MIN_PASSWORD = 8;
  const USERNAME_RE = /^[A-Za-z0-9_]{3,30}$/;
  const GENERIC_ERROR = "Mali ang username o password.";
  const CRYPTO_ERROR =
    "Hindi suportado ng browser na ito ang secure na password hashing. Buksan ang site sa localhost o HTTPS.";

  // ---------- Storage ----------
  function readJSON(key, fallback) {
    try {
      const value = JSON.parse(localStorage.getItem(key));
      return value === null || value === undefined ? fallback : value;
    } catch (e) {
      return fallback;
    }
  }

  function writeJSON(key, value) {
    localStorage.setItem(key, JSON.stringify(value));
  }

  // ---------- Password hashing (PBKDF2 + salt) ----------
  const encoder = new TextEncoder();

  function toHex(buffer) {
    return Array.from(new Uint8Array(buffer), (b) =>
      b.toString(16).padStart(2, "0")
    ).join("");
  }

  function randomSalt() {
    return toHex(crypto.getRandomValues(new Uint8Array(16)));
  }

  async function hashPassword(password, salt) {
    if (!globalThis.crypto || !crypto.subtle) throw new Error("NO_CRYPTO");
    const key = await crypto.subtle.importKey(
      "raw",
      encoder.encode(password),
      "PBKDF2",
      false,
      ["deriveBits"]
    );
    const bits = await crypto.subtle.deriveBits(
      { name: "PBKDF2", salt: encoder.encode(salt), iterations: 100000, hash: "SHA-256" },
      key,
      256
    );
    return toHex(bits);
  }

  const fail = (error) => ({ ok: false, error });
  const userId = (username) => "u:" + username.toLowerCase();

  // ---------- Auth logic ----------
  async function register(username, password, confirm) {
    username = (username || "").trim();
    password = password || "";

    if (!USERNAME_RE.test(username)) {
      return fail("Ang username ay 3-30 characters: letters, numbers, at underscore lang.");
    }
    if (password.length < MIN_PASSWORD) {
      return fail("Ang password ay dapat hindi bababa sa " + MIN_PASSWORD + " characters.");
    }
    if (password !== confirm) {
      return fail("Hindi magkapareho ang password at confirm password.");
    }

    const id = userId(username);
    if (readJSON(USERS_KEY, {})[id]) return fail("May gumagamit na ng username na iyon.");

    let salt, hash;
    try {
      salt = randomSalt();
      hash = await hashPassword(password, salt);
    } catch (e) {
      return fail(CRYPTO_ERROR);
    }

    const users = readJSON(USERS_KEY, {});
    if (users[id]) return fail("May gumagamit na ng username na iyon.");
    users[id] = { username, salt, hash, failed: 0, lockedUntil: 0, createdAt: Date.now() };
    writeJSON(USERS_KEY, users);
    return { ok: true };
  }

  async function login(username, password) {
    username = (username || "").trim();
    password = password || "";
    const id = userId(username);
    const existing = readJSON(USERS_KEY, {})[id];

    if (!existing) {
      try {
        await hashPassword(password, "dummy-salt"); // pareho ang bilis ng response
      } catch (e) {
        return fail(CRYPTO_ERROR);
      }
      return fail(GENERIC_ERROR);
    }

    const now = Date.now();
    if (existing.lockedUntil && existing.lockedUntil > now) {
      const minutes = Math.ceil((existing.lockedUntil - now) / 60000);
      return fail(
        "Na-lock ang account dahil sa sobrang daming maling subok. Subukan ulit pagkalipas ng " +
          minutes + " minuto."
      );
    }

    let hash;
    try {
      hash = await hashPassword(password, existing.salt);
    } catch (e) {
      return fail(CRYPTO_ERROR);
    }

    const users = readJSON(USERS_KEY, {});
    const user = users[id];
    if (!user) return fail(GENERIC_ERROR);

    if (hash === user.hash) {
      user.failed = 0;
      user.lockedUntil = 0;
      writeJSON(USERS_KEY, users);
      writeJSON(SESSION_KEY, { username: user.username, expires: Date.now() + SESSION_MS });
      return { ok: true, username: user.username };
    }

    user.failed = (user.failed || 0) + 1;
    if (user.failed >= MAX_FAILED) {
      user.failed = 0;
      user.lockedUntil = Date.now() + LOCK_MS;
    }
    writeJSON(USERS_KEY, users);
    return fail(GENERIC_ERROR);
  }

  function currentUser() {
    const session = readJSON(SESSION_KEY, null);
    if (!session || !session.username || session.expires < Date.now()) {
      if (session) localStorage.removeItem(SESSION_KEY);
      return null;
    }
    return session.username;
  }

  function logout() {
    localStorage.removeItem(SESSION_KEY);
  }

  // ---------- UI ----------
  function el(tag, className, text) {
    const node = document.createElement(tag);
    if (className) node.className = className;
    if (text !== undefined) node.textContent = text;
    return node;
  }

  const authArea = document.getElementById("authArea");
  const messageBox = document.getElementById("authMessage");
  const dialog = document.getElementById("authDialog");
  const form = document.getElementById("authForm");
  const title = document.getElementById("authTitle");
  const status = document.getElementById("authStatus");
  const usernameInput = document.getElementById("authUsername");
  const passwordInput = document.getElementById("authPassword");
  const confirmRow = document.getElementById("confirmRow");
  const confirmInput = document.getElementById("authConfirm");
  const submitBtn = document.getElementById("authSubmit");
  const switchLink = document.getElementById("authSwitch");
  const cancelBtn = document.getElementById("authCancel");

  let mode = "login";
  let messageTimer;

  function showMessage(text, kind) {
    messageBox.textContent = "";
    messageBox.appendChild(el("div", "flash " + kind, text));
    clearTimeout(messageTimer);
    messageTimer = setTimeout(() => (messageBox.textContent = ""), 4000);
  }

  function showStatus(text, kind) {
    status.textContent = text;
    status.className = "auth-status " + kind;
    status.hidden = false;
  }

  function hideStatus() {
    status.hidden = true;
    status.textContent = "";
  }

  function setMode(newMode) {
    mode = newMode;
    const isRegister = mode === "register";
    title.textContent = isRegister ? "Gumawa ng account" : "Mag-log in";
    submitBtn.textContent = isRegister ? "Mag-register" : "Log in";
    confirmRow.hidden = !isRegister;
    confirmInput.required = isRegister;
    passwordInput.autocomplete = isRegister ? "new-password" : "current-password";
    switchLink.textContent = isRegister
      ? "May account na? Mag-log in"
      : "Wala pang account? Mag-register";
    hideStatus();
  }

  function openDialog(newMode) {
    setMode(newMode);
    form.reset();
    dialog.showModal();
    usernameInput.focus();
  }

  function renderNav() {
    authArea.textContent = "";
    const user = currentUser();
    if (user) {
      const logoutBtn = el("button", "", "Log out");
      logoutBtn.type = "button";
      logoutBtn.addEventListener("click", () => {
        logout();
        renderNav();
        showMessage("Naka-log out ka na.", "success");
      });
      authArea.append(el("span", "who", "👤 " + user), logoutBtn);
    } else {
      const loginBtn = el("button", "btn-auth", "Log in");
      const registerBtn = el("button", "btn-auth", "Register");
      loginBtn.type = registerBtn.type = "button";
      loginBtn.addEventListener("click", () => openDialog("login"));
      registerBtn.addEventListener("click", () => openDialog("register"));
      authArea.append(loginBtn, registerBtn);
    }
  }

  form.addEventListener("submit", async (event) => {
    event.preventDefault();
    hideStatus();
    submitBtn.disabled = true;

    const username = usernameInput.value;
    const result =
      mode === "register"
        ? await register(username, passwordInput.value, confirmInput.value)
        : await login(username, passwordInput.value);

    submitBtn.disabled = false;

    if (!result.ok) {
      showStatus(result.error, "auth-error");
      return;
    }

    if (mode === "register") {
      const registered = username.trim();
      setMode("login");
      form.reset();
      usernameInput.value = registered;
      showStatus("Matagumpay ang pag-register! Pwede ka nang mag-log in.", "auth-ok");
      passwordInput.focus();
      return;
    }

    dialog.close();
    renderNav();
    showMessage("Maligayang pagdating, " + result.username + "!", "success");
  });

  switchLink.addEventListener("click", (event) => {
    event.preventDefault();
    setMode(mode === "login" ? "register" : "login");
  });

  cancelBtn.addEventListener("click", () => dialog.close());
  dialog.addEventListener("close", () => {
    form.reset();
    hideStatus();
  });
  window.addEventListener("storage", renderNav);

  renderNav();
})();
</script>

</body>
</html>
