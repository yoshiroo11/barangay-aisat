<style>
* { box-sizing: border-box; }

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7f5;
    color: #222;
}

header {
    background: #126b43;
    color: white;
    padding: 22px;
    text-align: center;
}

nav {
    background: #094b30;
    padding: 12px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 8px;
    font-size: 14px;
}

.hero {
    text-align: center;
    padding: 45px 15px;
    background: #dff5e6;
}

.hero h2 { color: #126b43; }

.seal { width: 64px; height: 64px; display: block; margin: 0 auto 8px; }

.hero-img, .about-img {
    width: 100%;
    max-width: 520px;
    height: auto;
    display: block;
    margin: 0 auto 18px;
    border-radius: 16px;
}
.about-img { margin: 18px auto 0; }

section {
    padding: 25px 15px;
    max-width: 900px;
    margin: auto;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 15px;
}

.card {
    background: white;
    padding: 20px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 2px 8px #00000010;
}

button {
    border: none;
    border-radius: 8px;
    padding: 13px;
    color: white;
    font-weight: bold;
    cursor: pointer;
    width: 100%;
}

.fire { background: #dc2626; }
.riot { background: #2563eb; }
.green { background: #15803d; }

input, textarea {
    width: 100%;
    padding: 12px;
    margin: 8px 0;
    border: 1px solid #ccc;
    border-radius: 7px;
}

footer {
    background: #094b30;
    color: white;
    padding: 20px;
    text-align: center;
    font-size: 13px;
}

/* ---------- Emergency link ---------- */
.emergency-types { margin-bottom: 18px; }
.emergency-types .card h3 { margin: 0; }
.emergency-link {
    display: inline-block;
    background: #dc2626;
    color: white;
    padding: 14px 24px;
    border-radius: 10px;
    font-weight: bold;
    text-decoration: none;
    box-shadow: 0 3px 12px #0000001a;
}
.emergency-link:hover { background: #b91c1c; }

/* ---------- Log in / Log out ---------- */
nav .auth {
    margin-left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 12px;
    vertical-align: middle;
}
nav .auth .who { color: white; font-size: 14px; font-weight: bold; }
nav .auth button {
    width: auto;
    margin: 0;
    padding: 6px 14px;
    border: 1px solid white;
    border-radius: 999px;
    background: transparent;
    color: white;
    font-size: 13px;
    font-weight: bold;
    cursor: pointer;
}
nav .auth button:hover { background: rgba(255, 255, 255, 0.18); }

.flash-bar { max-width: 900px; margin: 12px auto 0; padding: 0 16px; }
.flash-bar:empty { display: none; }
.flash-bar .flash { padding: 10px 14px; border-radius: 8px; font-size: 14px; }
.flash-bar .flash.success { background: #dcfce7; color: #166534; }

#authDialog {
    border: none;
    border-radius: 12px;
    padding: 24px;
    width: min(92vw, 380px);
    box-shadow: 0 10px 30px #00000040;
}
#authDialog::backdrop { background: rgba(0, 0, 0, 0.5); }
#authDialog h2 { margin: 0 0 12px; color: #126b43; }
#authDialog label { display: block; margin-top: 10px; font-size: 14px; font-weight: bold; }
#authDialog form button { margin-top: 14px; }
#authDialog .auth-status { padding: 10px 12px; border-radius: 8px; font-size: 14px; margin: 0 0 8px; }
#authDialog .auth-error { background: #fee2e2; color: #991b1b; }
#authDialog .auth-ok { background: #dcfce7; color: #166534; }
#authDialog .auth-switch { text-align: center; font-size: 14px; margin: 14px 0 6px; }
#authDialog .auth-switch a { color: #126b43; font-weight: bold; text-decoration: none; }
#authDialog .auth-cancel { background: transparent; color: #555; font-weight: normal; padding: 8px; }
</style>
</head>

